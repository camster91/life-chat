# Replace every value locally or in the VPS secret manager. Do not commit .env.
DATABASE_URL="postgresql://life_chat:replace-me@127.0.0.1:5432/life_chat"
BETTER_AUTH_URL="http://localhost:3000"
# At least 32 high-entropy characters. Generate and store outside the repository.
BETTER_AUTH_SECRET="replace-with-a-high-entropy-secret-of-at-least-32-characters"
