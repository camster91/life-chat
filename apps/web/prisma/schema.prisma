generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Better Auth records identify an account only. Household authority belongs to
// Member and is always resolved separately on the server.
model User {
  id                  String       @id
  name                String
  email               String       @unique
  emailVerified       Boolean      @default(false)
  image               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  sessions            Session[]
  accounts            Account[]
  members             Member[]
  acceptedInvitations Invitation[]

  @@map("auth_users")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verifications")
}

model Household {
  id           String        @id @default(cuid())
  name         String
  timeZone     String        @default("Etc/UTC")
  locale       String        @default("en-CA")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  members      Member[]
  invitations  Invitation[]
  miniAppConfigurations HouseholdMiniAppConfiguration[]
  sharedLists  SharedList[]
  sharedListItems SharedListItem[]
  choreAssignments ChoreAssignment[]
  notifications NotificationEnvelope[]
  notificationPreferences NotificationPreference[]
  auditEvents  AuditEvent[]
  outboxEvents OutboxEvent[]

  @@map("households")
}

enum ChoreAssignmentState {
  assigned
  completed
}

model ChoreAssignment {
  id                    String               @id @default(cuid())
  householdId           String
  assigneeMemberId      String
  title                 String
  dueDate               String?
  state                 ChoreAssignmentState @default(assigned)
  version               Int                  @default(1)
  completionCommandId   String?              @unique
  completedAt           DateTime?
  completedByMemberId   String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  household             Household            @relation(fields: [householdId], references: [id], onDelete: Restrict)

  @@index([householdId, assigneeMemberId, state])
  @@map("chore_assignments")
}

model SharedList {
  id        String           @id @default(cuid())
  householdId String
  title     String
  creationCommandId String? @unique
  version   Int              @default(1)
  archivedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  household Household        @relation(fields: [householdId], references: [id], onDelete: Restrict)
  items     SharedListItem[]

  @@index([householdId, updatedAt])
  @@map("shared_lists")
}

enum SharedListItemState {
  open
  completed
}

model SharedListItem {
  id                 String              @id @default(cuid())
  householdId        String
  listId             String
  label              String
  creationCommandId  String?             @unique
  position           Int
  state              SharedListItemState @default(open)
  version            Int                 @default(1)
  assignedMemberId   String?
  completedAt        DateTime?
  completedByMemberId String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  household          Household           @relation(fields: [householdId], references: [id], onDelete: Restrict)
  list               SharedList          @relation(fields: [listId], references: [id], onDelete: Restrict)

  @@unique([listId, position])
  @@index([householdId, state])
  @@index([assignedMemberId])
  @@map("shared_list_items")
}

model HouseholdMiniAppConfiguration {
  id                    String    @id @default(cuid())
  householdId           String
  appId                 String
  enabled               Boolean   @default(false)
  settingsSchemaVersion Int       @default(1)
  settings              Json      @default("{}")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  household             Household @relation(fields: [householdId], references: [id], onDelete: Restrict)

  @@unique([householdId, appId])
  @@index([householdId, enabled])
  @@map("household_mini_app_configurations")
}

model Member {
  id                     String          @id @default(cuid())
  householdId            String
  authenticatedSubjectId String?
  displayName            String
  role                   MemberRole
  lifecycle              MemberLifecycle @default(invited)
  expiresAt              DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  household              Household       @relation(fields: [householdId], references: [id], onDelete: Restrict)
  authenticatedSubject   User?           @relation(fields: [authenticatedSubjectId], references: [id], onDelete: Restrict)
  issuedInvitations      Invitation[]    @relation("InvitationIssuer")
  acceptedInvitation     Invitation?     @relation("InvitationAcceptedMember")
  notifications          NotificationEnvelope[]
  notificationPreference NotificationPreference?

  @@index([householdId])
  @@index([authenticatedSubjectId])
  @@unique([householdId, authenticatedSubjectId])
  @@unique([householdId, id])
  @@map("members")
}

enum NotificationEnvelopeState {
  scheduled
  available
  read
  dismissed
  cancelled
  failed
}

model NotificationEnvelope {
  id                String                    @id
  householdId       String
  recipientMemberId String
  templateId        String
  sourceEventId     String
  references        Json
  deduplicationKey  String                    @unique
  deliverAt         DateTime
  state             NotificationEnvelopeState @default(scheduled)
  deepLink          String?
  readAt            DateTime?
  dismissedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  household         Household                 @relation(fields: [householdId], references: [id], onDelete: Restrict)
  recipient         Member                    @relation(fields: [recipientMemberId], references: [id], onDelete: Restrict)

  @@index([householdId, recipientMemberId, state, deliverAt])
  @@map("notification_envelopes")
}

model NotificationPreference {
  id                    String    @id @default(cuid())
  householdId           String
  memberId              String
  remindersEnabled      Boolean   @default(true)
  quietHoursStartMinute Int?
  quietHoursEndMinute   Int?
  timeZone              String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  household             Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
  member                Member    @relation(fields: [householdId, memberId], references: [householdId, id], onDelete: Restrict)

  @@unique([householdId, memberId])
  @@map("notification_preferences")
}

enum MemberLifecycle {
  invited
  active
  suspended
  removed
}

enum MemberRole {
  adult
  child
  guest
}

model Invitation {
  id                  String     @id @default(cuid())
  householdId         String
  issuerMemberId      String
  tokenHash           String     @unique
  intendedRole        MemberRole
  intendedDisplayName String
  expiresAt           DateTime
  acceptedAt          DateTime?
  acceptedSubjectId   String?
  acceptedMemberId    String?    @unique
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  household           Household  @relation(fields: [householdId], references: [id], onDelete: Restrict)
  issuer              Member     @relation("InvitationIssuer", fields: [issuerMemberId], references: [id], onDelete: Restrict)
  acceptedSubject     User?      @relation(fields: [acceptedSubjectId], references: [id], onDelete: Restrict)
  acceptedMember      Member?    @relation("InvitationAcceptedMember", fields: [acceptedMemberId], references: [id], onDelete: Restrict)

  @@index([householdId, expiresAt])
  @@index([issuerMemberId])
  @@index([acceptedSubjectId])
  @@map("invitations")
}

model AuditEvent {
  id            String    @id
  householdId   String
  actorType     String
  actorId       String
  action        String
  targetType    String
  targetId      String
  outcome       String
  correlationId String
  causationId   String?
  metadata      Json
  occurredAt    DateTime
  createdAt     DateTime  @default(now())
  household     Household @relation(fields: [householdId], references: [id], onDelete: Restrict)

  @@index([householdId, occurredAt])
  @@index([correlationId])
  @@map("audit_events")
}

model OutboxEvent {
  id            String    @id
  householdId   String
  aggregateType String
  aggregateId   String
  eventType     String
  schemaVersion Int
  correlationId String
  causationId   String?
  references    Json
  occurredAt    DateTime
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  household     Household @relation(fields: [householdId], references: [id], onDelete: Restrict)

  @@index([householdId, createdAt])
  @@index([publishedAt])
  @@map("outbox_events")
}
